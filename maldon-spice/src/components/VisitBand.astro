---
import ClickMap from './ClickMap.astro';
import { bookHref, hoursLines, orderHref, phoneHref, site, smsHref } from '../lib/site';
---

<section id="visit" class="bg-primary section" aria-labelledby="visit-title">
  <div class="wrap">
    <h2 id="visit-title" class="display center title">Visit</h2>
    <div class="blocks">
      <div>
        <h3 class="label">Address</h3>
        <p>{site.name}<br />{site.address.streetAddress}<br />{site.address.addressLocality} {site.address.postalCode}</p>
      </div>
      <div>
        <h3 class="label">Hours</h3>
        {hoursLines.map((l) => <p>{l.days}<br />{l.times}</p>)}
      </div>
      <div>
        <h3 class="label">Contact</h3>
        <p>
          Call <a href={phoneHref}>{site.phone.display}</a><br />
          Text <a href={smsHref}>{site.sms.display}</a>
          {site.email && (<><br /><a href={`mailto:${site.email}`}>{site.email}</a></>)}
        </p>
      </div>
    </div>
    <p class="italic-display parking">{site.parking}</p>
    <div class="btn-row center actions">
      <a class="btn btn-solid" href={bookHref}>Reserve a table</a>
      <a class="btn btn-outline" href={orderHref}>Order for collection</a>
    </div>
    <ClickMap />
  </div>
</section>

<style>
  .center {
    text-align: center;
    justify-content: center;
  }
  .title {
    margin-bottom: 72px;
  }
  .blocks {
    display: flex;
    flex-wrap: wrap;
    gap: 40px 64px;
    justify-content: center;
    text-align: center;
    margin-bottom: 56px;
  }
  .blocks > div {
    flex: 1 1 240px;
    min-width: 0;
  }
  .blocks h3 {
    margin-bottom: 12px;
  }
  .parking {
    margin-bottom: 40px;
    text-align: center;
    font-size: 1.375rem;
  }
  .actions {
    margin-bottom: 64px;
  }
  @media (max-width: 720px) {
    .title {
      margin-bottom: 40px;
    }
  }
</style>
