---
import { bookHref, orderHref, phoneHref } from '../lib/site';
---

<nav class="mobile-bar on-deep" aria-label="Quick actions">
  <a href={phoneHref}>Call</a>
  <a href={bookHref} class="mid">Reserve</a>
  <a href={orderHref} class="primary">Order</a>
</nav>

<style>
  .mobile-bar {
    display: none;
  }
  @media (max-width: 720px) {
    .mobile-bar {
      display: flex;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 10;
      padding-bottom: env(safe-area-inset-bottom);
      background: var(--color-deep);
      border-top: 1px solid var(--color-hairline-deep);
    }
    .mobile-bar a {
      flex: 1 1 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: var(--bar-h);
      color: var(--color-white);
      text-decoration: none;
      font-size: var(--text-label);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      font-weight: 500;
    }
    .mobile-bar .mid {
      border-left: 1px solid var(--color-hairline-deep);
      border-right: 1px solid var(--color-hairline-deep);
    }
    .mobile-bar .primary {
      background: var(--color-primary);
      color: var(--color-ink);
    }
  }
</style>
