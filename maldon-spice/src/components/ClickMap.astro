---
// No third-party map on page load. The Google map only loads when the visitor asks for it.
import { directionsHref } from '../lib/site';

const embed = 'https://www.google.com/maps?q=Maldon+Spice,+111+High+Street,+Maldon+CM9+5BS&output=embed';
---

<div class="click-map" data-embed={embed}>
  <div class="map-inner">
    <p class="map-title">111 High Street, Maldon CM9 5BS</p>
    <p class="small map-note">The map is provided by Google and loads only when you choose to show it.</p>
    <div class="btn-row">
      <button type="button" class="btn btn-outline map-btn" hidden>Show map</button>
      <a class="tap" href={directionsHref}>Open in Google Maps</a>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.click-map').forEach((box) => {
    const btn = box.querySelector<HTMLButtonElement>('.map-btn');
    if (!btn) return;
    btn.hidden = false;
    btn.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = box.dataset.embed ?? '';
      frame.title = 'Map showing Maldon Spice, 111 High Street, Maldon';
      frame.loading = 'lazy';
      frame.referrerPolicy = 'no-referrer-when-downgrade';
      box.replaceChildren(frame);
      box.classList.add('loaded');
    });
  });
</script>

<style>
  .click-map {
    min-height: 380px;
    display: flex;
    align-items: flex-end;
    padding: 24px;
    background: var(--color-pale);
    color: var(--color-ink);
  }
  .click-map.loaded {
    padding: 0;
  }
  .click-map :global(iframe) {
    width: 100%;
    height: 380px;
    border: 0;
    display: block;
  }
  .map-title {
    font-weight: 500;
  }
  .map-note {
    margin: 4px 0 12px;
    color: var(--color-muted);
  }
  .map-btn {
    font-family: inherit;
    cursor: pointer;
    min-height: 48px;
    background: transparent;
  }
  .map-btn[hidden] {
    display: none;
  }
  @media (max-width: 720px) {
    .click-map {
      min-height: 260px;
    }
    .click-map :global(iframe) {
      height: 260px;
    }
  }
</style>
