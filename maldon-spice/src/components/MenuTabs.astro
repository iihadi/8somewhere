---
import { menus } from '../lib/menu';

interface Props {
  current: string;
}
const { current } = Astro.props;
const label: Record<string, string> = { main: 'Main menu', 'dairy-free': 'Dairy-free', drinks: 'Drinks' };
---

<nav class="tabs no-print" aria-label="Menus">
  {
    menus.map((m) => (
      <a href={m.path} aria-current={m.id === current ? 'page' : undefined}>
        {label[m.id] ?? m.title}
      </a>
    ))
  }
</nav>

<style>
  .tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-bottom: 24px;
  }
  .tabs a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 22px;
    border: 1px solid var(--color-deep);
    font-size: var(--text-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 500;
    text-decoration: none;
  }
  .tabs a[aria-current='page'] {
    background: var(--color-deep);
    color: var(--color-white);
  }
  @media (max-width: 720px) {
    .tabs a {
      padding: 0 12px;
      letter-spacing: 0.1em;
    }
  }
</style>
