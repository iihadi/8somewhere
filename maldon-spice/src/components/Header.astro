---
import { bookHref, orderHref } from '../lib/site';

const current = Astro.url.pathname;
const links = [
  { href: '/menu/', label: 'Menu', keep: true },
  { href: '/allergens/', label: 'Allergens' },
  { href: '/visit/', label: 'Visit' },
];
const isCurrent = (href: string) => (href === '/menu/' ? current.startsWith('/menu/') : current === href);
---

<header class="site-header">
  <a class="wordmark" href="/">Maldon Spice</a>
  <nav class="links" aria-label="Primary">
    {
      links.map((l) => (
        <a href={l.href} class:list={[{ keep: l.keep }]} aria-current={isCurrent(l.href) ? 'page' : undefined}>
          {l.label}
        </a>
      ))
    }
  </nav>
  <div class="acts">
    <a class="btn btn-outline" href={orderHref}>Order</a>
    <a class="btn btn-solid" href={bookHref}>Reserve</a>
  </div>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 32px;
    min-height: 64px;
    padding: 8px 40px;
    border-bottom: 1px solid var(--color-hairline);
    background: var(--color-white);
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 28px;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    font-weight: 500;
    text-decoration: none;
  }
  .links a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }
  .acts {
    display: flex;
    gap: 12px;
  }
  .acts .btn {
    min-height: 44px;
    padding: 0 22px;
  }
  @media (max-width: 720px) {
    .site-header {
      min-height: 56px;
      padding: 4px 20px;
      flex-wrap: nowrap;
    }
    .wordmark {
      font-size: 1.0625rem;
    }
    .acts,
    .links a:not(.keep) {
      display: none;
    }
  }
</style>
