---
import { codesText, fmtPrice, statusNote, type Item } from '../lib/menu';

interface Props {
  item: Item;
}
const { item } = Astro.props;
const codes = codesText(item);
const note = statusNote(item);
const labelled = item.prices.length > 1 && item.prices.every((p) => p.label);
const desc = [item.preorder ? 'Pre-order.' : '', item.description, codes].filter(Boolean).join(' ');
---

<div
  class="dish"
  data-dish
  data-allergens={item.allergens?.join(',') ?? ''}
  data-status={item.allergenStatus}
>
  <div class="dish-body">
    <p class="dish-name">{item.name}</p>
    {desc && <p class="dish-desc">{desc}</p>}
    {note && <p class="dish-desc dish-note">{note}</p>}
  </div>
  <p class="dish-price">
    {item.prices.map((p) => fmtPrice(p.amount)).join(' / ')}
    {labelled && <small>{item.prices.map((p) => p.label).join(' / ')}</small>}
    {!labelled && item.prices.length === 1 && item.prices[0].label && <small>{item.prices[0].label}</small>}
  </p>
</div>

<style>
  .dish-body {
    min-width: 0;
  }
  .dish-note {
    font-size: var(--text-small);
    font-style: italic;
  }
</style>
