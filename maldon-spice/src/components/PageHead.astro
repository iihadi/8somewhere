---
interface Props {
  title: string;
  lede?: string;
}
const { title, lede } = Astro.props;
---

<section class="bg-primary">
  <div class="page-head">
    <h1>{title}</h1>
    {lede && <p class="italic-display">{lede}</p>}
  </div>
</section>

<style>
  .page-head {
    max-width: 760px;
    margin: 0 auto;
    padding: 72px 32px 64px;
    text-align: center;
  }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(30px, 8vw, 48px);
    line-height: 1.1;
    letter-spacing: 0.12em;
    text-indent: 0.12em;
    text-transform: uppercase;
  }
  p {
    margin-top: 16px;
    font-size: clamp(1.25rem, 4vw, 1.5rem);
  }
  @media (max-width: 720px) {
    .page-head {
      padding: 48px 24px;
    }
  }
</style>
