---
// Allergen filter (main menu only). Progressive enhancement: without JS the full menu shows with codes.
// Safety rules (docs/06): a dish is hidden if it contains ANY selected allergen OR its allergens are
// not confirmed ("listed"). Never say "free from", "safe" or "suitable for".
import { filterChips } from '../lib/menu';
---

<div id="filter" class="filter" data-filter hidden>
  <h2 class="label">Hide dishes that contain</h2>
  <p class="small muted">A quick guide only. Please always tell your server about any allergy.</p>
  <div class="chips" role="group" aria-label="Allergens to hide">
    {
      filterChips.map((c) => (
        <button type="button" class="chip" data-code={c.code} aria-pressed="false">
          {c.label}
        </button>
      ))
    }
  </div>
  <p class="small status" aria-live="polite" data-count></p>
  <p class="small hidden-note" data-hidden-note hidden></p>
  <button type="button" class="clear" data-clear hidden>Clear all</button>
  <p class="none" data-none hidden>No dishes in this selection match. Please ask the team and we will help you choose.</p>
</div>

<script>
  const box = document.querySelector<HTMLElement>('[data-filter]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (box && menu) {
    box.hidden = false;
    const chips = [...box.querySelectorAll<HTMLButtonElement>('.chip')];
    const status = box.querySelector<HTMLElement>('[data-count]')!;
    const hiddenNote = box.querySelector<HTMLElement>('[data-hidden-note]')!;
    const clear = box.querySelector<HTMLButtonElement>('[data-clear]')!;
    const none = box.querySelector<HTMLElement>('[data-none]')!;
    const dishes = [...menu.querySelectorAll<HTMLElement>('[data-dish]')];
    const sections = [...menu.querySelectorAll<HTMLElement>('[data-section]')];
    const known = new Set(chips.map((c) => c.dataset.code!));
    const nameOf = (code: string) => chips.find((c) => c.dataset.code === code)!.textContent!.trim().toLowerCase();

    const readUrl = () =>
      new Set(
        (new URL(location.href).searchParams.get('avoid') ?? '')
          .split(',')
          .map((s) => s.trim())
          .filter((s) => known.has(s)),
      );

    function apply(avoid: Set<string>, push: boolean) {
      chips.forEach((c) => c.setAttribute('aria-pressed', String(avoid.has(c.dataset.code!))));
      let shown = 0;
      let unconfirmed = 0;
      for (const d of dishes) {
        const codes = (d.dataset.allergens ?? '').split(',').filter(Boolean);
        const listed = d.dataset.status === 'listed';
        let hide = false;
        if (avoid.size) {
          if (!listed) {
            hide = true;
            unconfirmed++;
          } else if (codes.some((c) => avoid.has(c))) hide = true;
        }
        d.hidden = hide;
        if (!hide) shown++;
      }
      for (const s of sections) {
        const empty = !s.querySelector('[data-dish]:not([hidden])');
        s.hidden = empty;
        const link = document.querySelector<HTMLElement>(`[data-jump="${s.id}"]`);
        if (link) link.hidden = empty;
      }
      if (avoid.size) {
        const names = [...avoid].map(nameOf).join(', ');
        status.textContent = `Showing ${shown} of ${dishes.length} dishes, hiding ${names}.`;
      } else {
        status.textContent = `Showing all ${dishes.length} dishes.`;
      }
      hiddenNote.hidden = unconfirmed === 0;
      hiddenNote.textContent = `${unconfirmed} ${unconfirmed === 1 ? 'dish is' : 'dishes are'} hidden because ${unconfirmed === 1 ? 'its' : 'their'} allergen information is not confirmed. Please ask us.`;
      clear.hidden = avoid.size === 0;
      none.hidden = !(avoid.size && shown === 0);

      if (push) {
        const url = new URL(location.href);
        if (avoid.size) url.searchParams.set('avoid', [...avoid].join(','));
        else url.searchParams.delete('avoid');
        history.replaceState(null, '', url);
      }
    }

    chips.forEach((c) =>
      c.addEventListener('click', () => {
        const avoid = readUrl();
        const code = c.dataset.code!;
        if (avoid.has(code)) avoid.delete(code);
        else avoid.add(code);
        apply(avoid, true);
      }),
    );
    clear.addEventListener('click', () => apply(new Set(), true));
    apply(readUrl(), false);
  }
</script>

<style>
  .filter {
    margin-bottom: 8px;
    padding: 24px;
    background: var(--color-mist);
    scroll-margin-top: 16px;
  }
  .filter[hidden],
  .filter [hidden] {
    display: none;
  }
  .filter h2 {
    margin-bottom: 4px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 16px 0;
  }
  .chip,
  .clear {
    min-height: 44px;
    padding: 0 18px;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    background: var(--color-white);
    color: var(--color-ink);
    border: 1px solid var(--color-deep);
  }
  .chip[aria-pressed='true'] {
    background: var(--color-deep);
    color: var(--color-white);
  }
  .chip[aria-pressed='true']::before {
    content: '\2715\00a0';
  }
  .hidden-note {
    margin-top: 8px;
    font-weight: 500;
  }
  .clear {
    margin-top: 12px;
  }
  .none {
    margin-top: 16px;
    padding: 16px;
    background: var(--color-white);
  }
</style>
