---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Photo from '../components/Photo.astro';
import { bookHref, site } from '../lib/site';
import { breadcrumbs } from '../lib/jsonld';
---

<Base path="/our-story/" withRestaurant jsonld={[breadcrumbs([{ name: 'Our story', path: '/our-story/' }])]}>
  <PageHead title="Our story" lede={site.tagline} />

  <section class="section">
    <div class="wrap story">
      <div class="prose">
        <p>
          Maldon Spice is run by Jhual and Shamema, who have worked in restaurants for more than thirty years. Before
          Maldon Spice, Jhual ran Maldon Tandoori.
        </p>
        <p>
          Grills are marinated in yoghurt and spices, then baked on skewers in a clay oven over charcoal. There are
          vegan specials, a dairy-free menu and a full allergen guide.
        </p>
        <p>
          The restaurant is at 111 High Street, the building where Maldon's first Indian restaurant opened in 1978.
        </p>
        <div class="btn-row actions">
          <a class="btn btn-solid" href={bookHref}>Reserve a table</a>
          <a class="btn btn-outline" href="/menu/">See the menu</a>
        </div>
      </div>
      <Photo id="table-setting-1" class="story-photo" />
    </div>
  </section>

  <section class="bg-mist section">
    <div class="recog">
      <p class="label">Award</p>
      <p class="italic-display big">{site.awards[0].name}</p>
      <p class="label">In the press</p>
      <p class="italic-display mid">&ldquo;{site.press[0].headline}&rdquo;</p>
      <p class="muted">{site.press[0].source}</p>
      <p class="history"><a class="tap" href="/heritage/">Read a short history of Maldon</a></p>
    </div>
  </section>
</Base>

<style>
  .story {
    display: flex;
    flex-wrap: wrap;
    gap: 48px 96px;
    align-items: center;
    justify-content: center;
  }
  .story .prose {
    flex: 1 1 340px;
  }
  .actions {
    margin-top: 32px;
  }
  :global(.story-photo) {
    flex: 0 1 420px;
    min-width: 260px;
  }
  .recog {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 32px;
    text-align: center;
  }
  .label {
    margin-bottom: 16px;
  }
  .big {
    margin-bottom: 56px;
    font-size: 1.875rem;
    line-height: 1.3;
  }
  .mid {
    margin-bottom: 8px;
    font-size: 1.5rem;
    line-height: 1.4;
  }
  .history {
    margin-top: 40px;
  }
</style>
