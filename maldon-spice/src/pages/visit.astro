---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import OpenNow from '../components/OpenNow.astro';
import ClickMap from '../components/ClickMap.astro';
import Photo from '../components/Photo.astro';
import { bookHref, closures, closureText, directionsHref, hoursLines, orderHref, phoneHref, site, smsHref } from '../lib/site';
import { breadcrumbs } from '../lib/jsonld';

const today = new Date().toISOString().slice(0, 10);
const upcoming = closures.filter((c) => c.to >= today);
---

<Base path="/visit/" withRestaurant jsonld={[breadcrumbs([{ name: 'Visit', path: '/visit/' }])]}>
  <PageHead title="Visit" lede={site.tagline} />

  <section class="section">
    <div class="wrap grid">
      <div class="info">
        <div class="block">
          <h2 class="label">Address</h2>
          <p>{site.name}<br />{site.address.streetAddress}<br />{site.address.addressLocality} {site.address.postalCode}</p>
          <a class="tap" href={directionsHref}>Get directions</a>
        </div>
        <div class="block">
          <h2 class="label">Hours</h2>
          {hoursLines.map((l) => <p>{l.days}, {l.times}</p>)}
          <OpenNow class="muted small" />
          {upcoming.map((c) => <p class="closure">{closureText(c)}</p>)}
        </div>
        <div class="block">
          <h2 class="label">Contact</h2>
          <p>
            Call <a href={phoneHref}>{site.phone.display}</a><br />
            Text <a href={smsHref}>{site.sms.display}</a>
            {site.email && (<><br /><a href={`mailto:${site.email}`}>{site.email}</a></>)}
          </p>
        </div>
        <div class="block">
          <h2 class="label">Parking</h2>
          <p>{site.parking}</p>
        </div>
      </div>
      <Photo id="exterior-night" class="visit-photo" sizes="(max-width: 720px) 100vw, 420px" />
    </div>
  </section>

  <section class="bg-mist section">
    <div class="wrap actions">
      <div id="reserve" class="action">
        <h2 class="display">Reserve a table</h2>
        <p class="muted">Book online, or call us on <a href={phoneHref}>{site.phone.display}</a>.</p>
        <a class="btn btn-solid" href={bookHref === '/visit/#reserve' ? phoneHref : bookHref}>
          {bookHref === '/visit/#reserve' ? `Call ${site.phone.display}` : 'Reserve a table'}
        </a>
      </div>
      <div id="order" class="action">
        <h2 class="display">Order for collection</h2>
        <p class="muted">Orders are for collection from the restaurant. We do not deliver.</p>
        <p class="muted">Call <a href={phoneHref}>{site.phone.display}</a> or text <a href={smsHref}>{site.sms.display}</a>.</p>
        <a class="btn btn-outline" href={orderHref === '/visit/#order' ? phoneHref : orderHref}>
          {orderHref === '/visit/#order' ? `Call ${site.phone.display}` : 'Order for collection'}
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="visually-hidden">Map</h2>
      <ClickMap />
    </div>
  </section>
</Base>

<style>
  .grid {
    display: flex;
    flex-wrap: wrap;
    gap: 48px 96px;
    align-items: flex-start;
  }
  .info {
    flex: 1 1 340px;
    min-width: 0;
  }
  .block + .block {
    margin-top: 32px;
  }
  .block h2 {
    margin-bottom: 8px;
  }
  .closure {
    margin-top: 8px;
    font-weight: 500;
  }
  :global(.visit-photo) {
    flex: 0 1 420px;
    min-width: 260px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 56px 96px;
  }
  .action {
    flex: 1 1 300px;
    min-width: 0;
    scroll-margin-top: 16px;
  }
  .action h2 {
    margin-bottom: 16px;
  }
  .action p {
    margin-bottom: 12px;
  }
  .action .btn {
    margin-top: 12px;
  }
</style>
