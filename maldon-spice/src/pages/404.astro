---
import Base from '../layouts/Base.astro';
import { phoneHref, site } from '../lib/site';
---

<Base path="/404/" title="Page not found | Maldon Spice" description="That page has moved or does not exist." noindex>
  <section class="bg-primary">
    <div class="nf">
      <h1>Page not found</h1>
      <p>That page has moved or does not exist.</p>
      <div class="btn-row">
        <a class="btn btn-solid" href="/menu/">Menu</a>
        <a class="btn btn-outline" href="/visit/">Visit</a>
        <a class="btn btn-outline" href="/">Home</a>
      </div>
      <p class="call">Or call us on <a href={phoneHref}>{site.phone.display}</a>.</p>
    </div>
  </section>
</Base>

<style>
  .nf {
    max-width: 760px;
    margin: 0 auto;
    padding: 96px 32px;
    text-align: center;
  }
  h1 {
    margin-bottom: 16px;
    font-family: var(--font-display);
    font-size: clamp(30px, 8vw, 48px);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .btn-row {
    justify-content: center;
    margin: 32px 0 24px;
  }
</style>
