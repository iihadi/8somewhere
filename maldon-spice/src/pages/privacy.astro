---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { phoneHref, site } from '../lib/site';
import { breadcrumbs } from '../lib/jsonld';
---

<Base path="/privacy/" jsonld={[breadcrumbs([{ name: 'Privacy and cookies', path: '/privacy/' }])]}>
  <PageHead title="Privacy and cookies" />

  <section class="section">
    <div class="wrap narrow">
      <div class="prose">
        <h2 class="section-title">Who we are</h2>
        <p>
          This website is run by {site.name}, {site.address.streetAddress}, {site.address.addressLocality}
          {site.address.postalCode}.
        </p>

        <h2 class="section-title">What this website collects</h2>
        <p>
          This website has no forms and no accounts, and it does not collect personal data itself. If you call, text
          or email us, we use your details only to answer you and to look after your booking or order.
        </p>

        <h2 class="section-title">Bookings and orders</h2>
        <p>
          Online bookings and collection orders are handled by our till and booking provider, Mobi POS. When you use
          those pages, Mobi processes your details under its own privacy policy and may set its own cookies.
        </p>

        <h2 class="section-title">Hosting</h2>
        <p>
          The site is hosted by IONOS. Like any web server, it keeps short-lived technical logs (such as IP addresses)
          to keep the site secure and running.
        </p>

        <h2 class="section-title">Maps</h2>
        <p>
          The map on our Visit page is provided by Google. It does not load unless you choose to show it. If you do,
          Google may set cookies and receive your IP address under its own privacy policy.
        </p>

        <h2 id="cookies" class="section-title">Cookies</h2>
        <p>
          This website sets no cookies of its own and uses no advertising or tracking. The allergen filter keeps your
          choices in the page address, not in a cookie.
        </p>

        <h2 class="section-title">Your data and how to contact us</h2>
        <p>
          To ask about any personal data we hold, or to have it corrected or deleted, call us on
          <a href={phoneHref}>{site.phone.display}</a> or write to us at the address above. You can also contact the
          Information Commissioner's Office (ico.org.uk).
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .narrow {
    max-width: calc(var(--measure) + 2 * var(--space-gutter));
  }
  .prose h2 {
    margin: 40px 0 12px;
  }
  .prose h2:first-child {
    margin-top: 0;
  }
  .prose p + h2 {
    margin-top: 40px;
  }
</style>
