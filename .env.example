# Copy this file to .env.local for local development.
# On Vercel, set these under Project Settings -> Environment Variables
# instead (BLOB_READ_WRITE_TOKEN is set for you automatically once you
# link a Blob store — see README.md).

# Login for /edit.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Signs the /edit session cookie. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=

# Vercel Blob token. Leave unset for local dev — the site falls back to
# storing data in data/reviews.local.json and public/uploads/ instead.
# BLOB_READ_WRITE_TOKEN=

# Your deployed domain, used in the sitemap and social-share metadata.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# No key needed for the "Look up restaurant details" button in /edit —
# it reuses the same free OpenStreetMap/Nominatim service as the
# address lookup above. See README.md.
